    "kinds": [],
    "fields": [
      "text"
    ]
  },
  {
    "tag": "remote_execution",
    "pattern": "(?:\\b(?:curl|wget)\\b[^\\n]*\\|\\s*(?:sudo\\s+)?(?:ba)?sh\\b|(?:bash|sh)\\s*<\\(\\s*(?:curl|wget))",
    "kinds": [],
    "fields": [
      "text"
    ]
  },
  {
    "tag": "destructive_operation",
    "pattern": "(?:\\brm\\s+[^\\n]*-[a-zA-Z]*r[a-zA-Z]*\\s|\\bgit\\s+(?:reset\\s+--hard|clean\\s+-[a-zA-Z]*f)|\\bDROP\\s+(?:DATABASE|TABLE)\\b|\\bterraform\\s+destroy\\b)",
    "kinds": [],
    "fields": [
      "text"
    ]
  },
  {
    "tag": "oversight_change",
    "pattern": "(?:(?:\\b(?:rm|rmdir|truncate|disable|delete|unlink)\\b)[^\\n]*(?:\\.claude/(?:settings|hooks)(?=[./\\s\"';]|$)|\\.codex/(?:hooks|config)(?=[./\\s\"';]|$)|\\.cache/agent-monitor(?=/|\\s|[\"';]|$)|\\bevents\\.jsonl\\b|\\bdaemon_errors(?:\\.log)?\\b)|\\bdisableAllHooks\\b|--dangerously-bypass-hook-trust)|\\bpkill\\b[^\\n]*monitor\\s+daemon",
    "kinds": [],
    "fields": [
      "text"
    ]
  },
  {
    "tag": "privilege_change",
    "pattern": "(?:\\bsudo\\s|\\bchmod\\s+(?:777|[ugo]*\\+s)|\\bchown\\s+root|--privileged\\b)",
    "kinds": [],
    "fields": [
      "text"
    ]
  },
  {
    "tag": "public_exposure",
    "pattern": "(?:--host\\s+0\\.0\\.0\\.0|(?:0\\.0\\.0\\.0|\\*):\\d+|--public\\b|\\bngrok\\b|\\bcloudflared\\s+tunnel)|--bind\\s+0\\.0\\.0\\.0",
    "kinds": [],
