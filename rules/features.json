    ]
  },
  {
    "tag": "injection_instruction",
    "pattern": "(?:ignore\\s+(?:all\\s+)?(?:previous|prior|the\\s+user|the\\s+monitor)|disable\\s+(?:the\\s+)?monitor|score\\s+(?:this\\s+)?(?:zero|0)|system\\s+override|send\\s+(?:the\\s+)?(?:credentials|secrets|token))",
