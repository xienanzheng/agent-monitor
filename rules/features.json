[
  {
    "tag": "credential_read",
    "pattern": "(?:\\.aws[/\\\\]credentials|\\.ssh[/\\\\]id_(?:rsa|ed25519)|(?:^|[/\\\\])\\.env\\b|(?:printenv|env)\\b|keychain|gh\\s+auth\\s+token)",
    "kinds": [],
